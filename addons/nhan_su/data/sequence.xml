            <field name="code">hop_dong_lao_dong</field>
            <field name="prefix">HĐ/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_nghi_phep" model="ir.sequence">
            <field name="name">Số đơn nghỉ phép</field>
            <field name="code">nghi_phep</field>
            <field name="prefix">NP/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
