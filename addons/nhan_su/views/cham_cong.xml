<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============ CHẤM CÔNG ============ -->
        <record id="view_cham_cong_form" model="ir.ui.view">
            <field name="name">cham_cong.form</field>
            <field name="model">cham_cong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_xac_nhan" string="Xác nhận" type="object"
                                class="btn-primary" attrs="{'invisible': [('trang_thai', '!=', 'cho_xac_nhan')]}"/>
                        <button name="action_tu_choi" string="Từ chối" type="object"
                                attrs="{'invisible': [('trang_thai', '!=', 'cho_xac_nhan')]}"/>
                        <field name="trang_thai" widget="statusbar"
                               statusbar_visible="cho_xac_nhan,da_xac_nhan"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Thông tin chấm công">
                                <field name="nhan_vien_id"/>
                                <field name="ngay"/>
                                <field name="loai_cong"/>
                            </group>
                            <group string="Giờ làm việc">
                                <field name="gio_vao" widget="float_time"/>
                                <field name="gio_ra" widget="float_time"/>
                                <field name="so_gio_lam" widget="float_time" readonly="1"/>
                                <field name="so_gio_tang_ca" widget="float_time"/>
                            </group>
                        </group>
                        <field name="ghi_chu" placeholder="Ghi chú..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cham_cong_tree" model="ir.ui.view">
            <field name="name">cham_cong.tree</field>
            <field name="model">cham_cong</field>
            <field name="arch" type="xml">
                <tree decoration-success="trang_thai == 'da_xac_nhan'"
                      decoration-danger="trang_thai == 'tu_choi'"
                      editable="bottom">
                    <field name="nhan_vien_id"/>
                    <field name="ngay"/>
                    <field name="loai_cong"/>
                    <field name="gio_vao" widget="float_time"/>
                    <field name="gio_ra" widget="float_time"/>
                    <field name="so_gio_lam" widget="float_time" readonly="1"/>
                    <field name="so_gio_tang_ca" widget="float_time"/>
                    <field name="trang_thai"/>
                    <field name="ghi_chu"/>
                </tree>
            </field>
        </record>

        <record id="view_cham_cong_search" model="ir.ui.view">
            <field name="name">cham_cong.search</field>
            <field name="model">cham_cong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nhan_vien_id"/>
                    <field name="ngay"/>
                    <filter string="Hôm nay" name="today" domain="[('ngay','=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="Chờ xác nhận" name="cho_xn" domain="[('trang_thai','=','cho_xac_nhan')]"/>
                    <filter string="Đã xác nhận" name="da_xn" domain="[('trang_thai','=','da_xac_nhan')]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Nhân viên" name="group_nv" context="{'group_by': 'nhan_vien_id'}"/>
                        <filter string="Tháng" name="group_month" context="{'group_by': 'ngay:month'}"/>
                        <filter string="Loại công" name="group_loai" context="{'group_by': 'loai_cong'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_cham_cong" model="ir.actions.act_window">
            <field name="name">Chấm công</field>
            <field name="res_model">cham_cong</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_cham_cong_search"/>
        </record>
    </data>
</odoo>
