<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============ ĐỢT ĐÁNH GIÁ ============ -->
        <record id="view_kpi_dot_form" model="ir.ui.view">
            <field name="name">kpi_dot_danh_gia.form</field>
            <field name="model">kpi_dot_danh_gia</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_bat_dau" string="Bắt đầu đánh giá" type="object"
                                class="btn-primary" attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}"/>
                        <button name="action_hoan_thanh" string="Hoàn thành" type="object"
                                class="btn-success" attrs="{'invisible': [('trang_thai', '!=', 'dang_thuc_hien')]}"/>
                        <field name="trang_thai" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="ten_dot"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="ky_danh_gia"/>
                                <field name="tu_ngay"/>
                                <field name="den_ngay"/>
                                <field name="tong_nhan_vien" readonly="1"/>
                            </group>
                            <group>
                                <field name="mo_ta"/>
                            </group>
                        </group>
                        <field name="kpi_ids">
                            <tree>
                                <field name="nhan_vien_id"/>
                                <field name="phong_ban_id"/>
                                <field name="diem_tu_danh_gia"/>
                                <field name="diem_quan_ly_danh_gia"/>
                                <field name="diem_tong_hop"/>
                                <field name="xep_loai"/>
                                <field name="trang_thai"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kpi_dot_tree" model="ir.ui.view">
            <field name="name">kpi_dot_danh_gia.tree</field>
            <field name="model">kpi_dot_danh_gia</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ten_dot"/>
                    <field name="ky_danh_gia"/>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="tong_nhan_vien"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <record id="action_kpi_dot_danh_gia" model="ir.actions.act_window">
            <field name="name">Đợt đánh giá KPI</field>
            <field name="res_model">kpi_dot_danh_gia</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ============ KPI NHÂN VIÊN ============ -->
        <record id="view_kpi_nhan_vien_form" model="ir.ui.view">
            <field name="name">kpi_nhan_vien.form</field>
            <field name="model">kpi_nhan_vien</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="trang_thai" widget="statusbar"
                               statusbar_visible="chua_danh_gia,nhan_vien_da_nhap,quan_ly_da_nhap,hoan_thanh"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Thông tin">
                                <field name="nhan_vien_id"/>
                                <field name="dot_danh_gia_id"/>
                                <field name="phong_ban_id" readonly="1"/>
                                <field name="chuc_vu_id"/>
                            </group>
                            <group string="Kết quả đánh giá">
                                <field name="diem_tu_danh_gia" readonly="1"
                                       />
                                <field name="diem_quan_ly_danh_gia" readonly="1"/>
                                <field name="diem_tong_hop" readonly="1"
                                       style="font-weight:bold;font-size:1.2em"/>
                                <field name="xep_loai" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Tiêu chí KPI">
                                <field name="tieu_chi_ids">
                                    <tree editable="bottom">
                                        <field name="ten_tieu_chi"/>
                                        <field name="mo_ta"/>
                                        <field name="trong_so"/>
                                        <field name="muc_tieu"/>
                                        <field name="ket_qua_thuc_te"/>
                                        <field name="diem_tu_danh_gia"/>
                                        <field name="diem_quan_ly"/>
                                        <field name="nhan_xet"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Nhận xét tổng hợp">
                                <group>
                                    <group string="Nhận xét của nhân viên">
                                        <field name="nhan_xet_nhan_vien" nolabel="1"/>
                                    </group>
                                    <group string="Nhận xét của quản lý">
                                        <field name="nhan_xet_quan_ly" nolabel="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                        <div class="oe_chatter">
                            <field name="message_follower_ids"/>
                            <field name="message_ids"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kpi_nhan_vien_tree" model="ir.ui.view">
            <field name="name">kpi_nhan_vien.tree</field>
            <field name="model">kpi_nhan_vien</field>
            <field name="arch" type="xml">
                <tree decoration-success="xep_loai in ('xuat_sac','tot')"
                      decoration-warning="xep_loai == 'trung_binh'"
                      decoration-danger="xep_loai == 'kem'">
                    <field name="nhan_vien_id"/>
                    <field name="dot_danh_gia_id"/>
                    <field name="phong_ban_id"/>
                    <field name="diem_tu_danh_gia"/>
                    <field name="diem_quan_ly_danh_gia"/>
                    <field name="diem_tong_hop"/>
                    <field name="xep_loai"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <record id="view_kpi_nhan_vien_search" model="ir.ui.view">
            <field name="name">kpi_nhan_vien.search</field>
            <field name="model">kpi_nhan_vien</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nhan_vien_id"/>
                    <field name="dot_danh_gia_id"/>
                    <filter string="Xuất sắc" name="xuat_sac" domain="[('xep_loai','=','xuat_sac')]"/>
                    <filter string="Tốt" name="tot" domain="[('xep_loai','=','tot')]"/>
                    <filter string="Kém" name="kem" domain="[('xep_loai','=','kem')]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Phòng ban" name="group_pb" context="{'group_by': 'phong_ban_id'}"/>
                        <filter string="Xếp loại" name="group_xl" context="{'group_by': 'xep_loai'}"/>
                        <filter string="Đợt đánh giá" name="group_dot" context="{'group_by': 'dot_danh_gia_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_kpi_nhan_vien" model="ir.actions.act_window">
            <field name="name">Đánh giá KPI nhân viên</field>
            <field name="res_model">kpi_nhan_vien</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_kpi_nhan_vien_search"/>
        </record>
    </data>
</odoo>
